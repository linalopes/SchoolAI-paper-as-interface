    {
      "type": "text",
      "id": "RS9-c5JXg5jQRqTDghqla",
      "x": -849.7278795799207,
      "y": 143.1363147101573,
      "width": 395.80173672264175,
      "height": 112.5,
      "text": "· Do I need an Arduino to join the experience?\n· Do I need electronics experience?\n· Can I just watch online?\n· What materials do I need if I'm online?\n· Will the prototypes be finished by the end?",
      "fontSize": 14,
      "fontFamily": 3,
      "color": "#1c1c1e",
      "version": 267,
      "versionNonce": 1452332825,
      "isDeleted": false,
