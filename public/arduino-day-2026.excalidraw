    {
      "id": "zRDImJlyI2pv_m7YfRgYP",
      "type": "text",
      "x": -438.95866518478624,
      "y": 139.93357578506527,
      "width": 245.8454810705789,
      "height": 120,
      "angle": 0,
      "strokeColor": "#22113E",
      "backgroundColor": "#502893",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b47",
      "roundness": null,
      "seed": 1780461081,
      "version": 142,
      "versionNonce": 746097657,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "DcWgTEMvgxLxvLW0hwQPG",
          "type": "arrow"
        },
        {
          "id": "bkw84h_OrKqGjBubbwIXk",
          "type": "arrow"
        },
        {
          "id": "9iG2beGXmyZPRnN3_zU4h",
          "type": "arrow"
        }
      ],
      "updated": 1774648417966,
      "link": null,
      "locked": false,
      "text": "Not at all. The session is\ndesigned to work for curious\nbeginners. You learn by\nwatching, asking, and trying.\nThis is a live build, not a demo.\nProductive failure is welcome.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not at all. The session is designed to work for curious beginners. You learn by watching, asking, and trying. This is a live build, not a demo. Productive failure is welcome.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
